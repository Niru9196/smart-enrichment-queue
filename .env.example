# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=4000
# Local: docker compose Postgres. Neon: use the pooled connection string here.
DATABASE_URL=postgresql://seq:seq@localhost:5433/seq_dev
# Neon: use the direct (non-pooled) connection string for migrations. Locally, same as DATABASE_URL.
DIRECT_URL=postgresql://seq:seq@localhost:5433/seq_dev
# Comma-separated list of allowed browser origins. Required in production; no localhost fallback there.
FRONTEND_ORIGIN=http://localhost:5173
DEMO_USER_EMAIL=demo@saasquatch.local
# Simulated credits charged per enrichment (SaaSquatch: one credit unlocks a full lead profile).
CREDITS_PER_ENRICHMENT=1
# debug | info | warn | error (tests always log errors only).
LOG_LEVEL=info

# ---- Web (apps/web/.env) ----
VITE_API_BASE_URL=http://localhost:4000/api/v1
